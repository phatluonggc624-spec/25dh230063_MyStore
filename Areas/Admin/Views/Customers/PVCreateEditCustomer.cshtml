@model _25dh230063_MyStore.Models.Customer

<div class="row mb-3">
    <div class="col-md-2 col-form-label">Họ và tên</div>
    <div class="col-md-6">
        @Html.EditorFor(model => model.CustomerName, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.CustomerName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-2 col-form-label">Số điện thoại</div>
    <div class="col-md-6">
        @Html.EditorFor(model => model.CustomerPhone, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.CustomerPhone, "", new { @class = "text-danger" })
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-2 col-form-label">Email</div>
    <div class="col-md-6">
        @Html.EditorFor(model => model.CustomerEmail, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.CustomerEmail, "", new { @class = "text-danger" })
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-2 col-form-label">Địa chỉ</div>
    <div class="col-md-6">
        @Html.EditorFor(model => model.CustomerAddress, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.CustomerAddress, "", new { @class = "text-danger" })
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-2 col-form-label">Tên đăng nhập</div>
    <div class="col-md-6">
        @Html.DropDownList("Username", null, htmlAttributes: new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6 offset-md-2">
        <input type="submit" value="Lưu" class="btn btn-primary" />
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
    </div>
</div>
