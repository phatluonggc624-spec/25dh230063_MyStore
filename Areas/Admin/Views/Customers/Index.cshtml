@model IEnumerable<_25dh230063_MyStore.Models.Customer>
@using System.Linq

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .customer-table thead th {
        background-color: #e2f0d9;
        vertical-align: middle;
    }

    .customer-table tbody td {
        background-color: #d9edf7;
        vertical-align: middle;
        padding: 10px;
    }

    .customer-actions {
        white-space: nowrap;
    }
</style>

<h2 class="bg-success">QUẢN LÝ KHÁCH HÀNG</h2>

@if (Model != null && Model.Any())
{
    <table class="table customer-table">
        <thead>
            <tr>
                <th>Tên khách hàng</th>
                <th>Số điện thoại</th>
                <th>Email</th>
                <th>Địa chỉ</th>
                <th>Tên đăng nhập</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CustomerName</td>
                    <td>@item.CustomerPhone</td>
                    <td>@item.CustomerEmail</td>
                    <td>@item.CustomerAddress</td>
                    <td>@item.Username</td>

                    <td class="customer-actions">
                        @Html.ActionLink("Sửa", "Edit", new { id = item.CustomerID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = item.CustomerID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Xóa", "Delete", new { id = item.CustomerID }, new { @class = "btn btn-primary btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Không tìm thấy khách hàng nào.</p>
}

<div class="mt-3">
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</div>