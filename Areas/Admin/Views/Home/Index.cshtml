@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h2 class="mt-3 mb-4" style="font-weight: bold;">Bảng Điều Khiển</h2>

    <!-- HÀNG THỐNG KÊ (4 THẺ) -->
    <div class="row">
        <!-- Sản phẩm -->
        <div class="col-md-3 mb-4">
            <div class="card shadow h-100 py-2" style="border-left: 5px solid #4e73df;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div style="color: #4e73df; font-weight: bold; font-size: 13px; text-transform: uppercase;">Sản phẩm</div>
                            <div style="font-size: 24px; font-weight: bold; color: #333;">@ViewBag.TotalProducts</div>
                        </div>
                        <div class="col-auto"><span style="font-size: 30px; opacity: 0.5;">📦</span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Khách hàng -->
        <div class="col-md-3 mb-4">
            <div class="card shadow h-100 py-2" style="border-left: 5px solid #1cc88a;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div style="color: #1cc88a; font-weight: bold; font-size: 13px; text-transform: uppercase;">Khách hàng</div>
                            <div style="font-size: 24px; font-weight: bold; color: #333;">@ViewBag.TotalCustomers</div>
                        </div>
                        <div class="col-auto"><span style="font-size: 30px; opacity: 0.5;">👥</span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Đơn hàng -->
        <div class="col-md-3 mb-4">
            <div class="card shadow h-100 py-2" style="border-left: 5px solid #36b9cc;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div style="color: #36b9cc; font-weight: bold; font-size: 13px; text-transform: uppercase;">Đơn hàng</div>
                            <div style="font-size: 24px; font-weight: bold; color: #333;">@ViewBag.TotalOrders</div>
                        </div>
                        <div class="col-auto"><span style="font-size: 30px; opacity: 0.5;">🧾</span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doanh thu -->
        <div class="col-md-3 mb-4">
            <div class="card shadow h-100 py-2" style="border-left: 5px solid #f6c23e;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div style="color: #f6c23e; font-weight: bold; font-size: 13px; text-transform: uppercase;">Doanh thu</div>
                            <div style="font-size: 20px; font-weight: bold; color: #333;">@ViewBag.TotalRevenue.ToString("N0") đ</div>
                        </div>
                        <div class="col-auto"><span style="font-size: 30px; opacity: 0.5;">💰</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG ĐƠN HÀNG MỚI NHẤT -->
    <div class="card shadow mb-4">
        <div class="card-header py-3" style="background-color: white; border-bottom: 1px solid #e3e6f0;">
            <h6 class="m-0 font-weight-bold" style="color: #4e73df;">🕒 Đơn hàng mới nhất</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="bg-light">
                        <tr>
                            <th>Mã ĐH</th>
                            <th>Khách Hàng</th>
                            <th>Ngày Đặt</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentOrders != null)
                        {
                            foreach (var item in ViewBag.RecentOrders)
                            {
                                <tr>
                                    <td><b>#@item.OrderID</b></td>
                                    <td>@item.Customer.CustomerName</td>
                                    <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="color: red; font-weight: bold;">@item.TotalAmount.ToString("N0") đ</td>
                                    <td>
                  
                                        <span class="badge bg-warning text-dark">@item.PaymentStatus</span>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", "Orders", new { id = item.OrderID, area = "Admin" })" class="btn btn-primary btn-sm">Xem chi tiết</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>