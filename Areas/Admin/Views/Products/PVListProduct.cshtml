@model _25dh230063_MyStore.Models.ViewModel.ProductSearchVM
@using System.Linq
@using PagedList
@using PagedList.Mvc

<style>
    .product-img {
        width: 140px;
        height: 140px;
        object-fit: contain;
    }

    .product-table thead th {
        background-color: #e2f0d9;
        vertical-align: middle;
    }

    .product-table tbody td {
        background-color: #d9edf7;
        vertical-align: top;
        padding: 10px;
    }

    .product-actions {
        white-space: nowrap;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
    }

        .pagination-container ul {
            list-style: none;
            display: flex;
            gap: 4px;
            padding: 0;
        }

        .pagination-container li a,
        .pagination-container li span {
            display: block;
            padding: 6px 12px;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            text-decoration: none;
        }

        .pagination-container li.active a,
        .pagination-container li.active span {
            background-color: #0d6efd;
            color: #fff;
        }

        .pagination-container li.disabled span {
            color: #999;
        }
</style>

<h2 class="bg-success">DANH SÁCH SẢN PHẨM</h2>

@if (Model.Products != null && Model.Products.Any())
{
    <table class="table product-table">
        <thead>
            <tr>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Đơn giá</th>
                <th>Danh mục</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td>
           <img src="@(string.IsNullOrEmpty(item.ProductImage) ? Url.Content("~/Content/images/default_img.jpg")
            : (item.ProductImage.StartsWith("http")? item.ProductImage
             : Url.Content("~/Content/images/" + item.ProductImage)))"
               alt="@item.ProductName"
              class="product-img" />
                    </td>

                    <td>@item.ProductName</td>
                    <td>@string.Format("{0:N0} đ", item.ProductPrice)</td>
                    <td>@(item.Category != null ? item.Category.CategoryName : "")</td>

                    <td class="product-actions">
                        @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* Hiển thị phân trang *@
    <div class="pagination-container">
        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new
        {
            page,
            searchTerm = Model.SearchTerm,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice,
            sortOrder = Model.SortOrder
        }))
    </div>
}
else
{
    <p>Không tìm được sản phẩm nào phù hợp.</p>
}

<div class="mt-3">
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</div>