@model _25dh230063_MyStore.Models.Product

@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">CẬP NHẬT SẢN PHẨM</h2>

@using (Html.BeginForm("Edit", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

<div class="mt-3">
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.ProductID)
    @Html.HiddenFor(model => model.ProductImage) 
    @*Giữ lại đường dẫn ảnh cũ khi người dùng không chọn ảnh mới.*@

    @* Nhúng Partial View vào form cha *@
    @Html.Partial("PVCreateEditProduct", Model)
</div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
                // Cho phép nhập số có dấu phẩy (kiểu Việt Nam)
                $.validator.methods.number = function (value, element) {
                    return this.optional(element) || /^-?\d+(?:[.,]\d+)?$/.test(value);
                };
                $.validator.methods.range = function (value, element, param) {
                    var v = parseFloat(String(value).replace(',', '.'));
                    return this.optional(element) || (v >= param[0] && v <= param[1]);
                };
    </script>
}