@model IEnumerable<_25dh230063_MyStore.Models.Order>
@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success" style="padding: 10px; color: white;">DANH SÁCH ĐƠN HÀNG</h2>

<table class="table table-bordered">
    <tr class="bg-info">
        <th>Mã Đơn</th>
        <th>Khách Hàng</th>
        <th>Ngày Đặt</th>
        <th>Tổng Tiền</th>
        <th>Trạng Thái</th>
        <th>Thao Tác</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>#@item.OrderID</td>
            <td>@Html.DisplayFor(modelItem => item.Customer.CustomerName)</td>
            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
            <td style="color: red; font-weight: bold;">@item.TotalAmount.ToString("N0") đ</td>
            <td>@Html.DisplayFor(modelItem => item.PaymentStatus)</td>
            <td>
                @Html.ActionLink("Xem Chi Tiết", "Details", new { id = item.OrderID }, new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>
    }
</table>
