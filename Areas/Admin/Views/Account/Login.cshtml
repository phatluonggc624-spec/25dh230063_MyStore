@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta name="viewport" content="width=device-width" charset="UTF-8" />
    <title>Đăng nhập Admin - LEGO</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/sign/login.css")?v=3" />
</head>

<body>
    <div class="container">
        <img src="https://thumb.wikimedia.org/wikipedia/commons/thumb/2/24/LEGO_logo.svg/1280px-LEGO_logo.svg.png" alt="LEGO" class="LEGO">

        <h1>Đăng nhập Admin</h1>

        @if (ViewBag.Error != null)
        {
            <div style="color: red; text-align: center; font-weight: bold; margin-bottom: 15px;">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Login", "Account", new { area = "Admin" }, FormMethod.Post))
        {
            <label>Tên đăng nhập:</label>
            <input type="text" name="username" placeholder="Nhập tên đăng nhập" required />
            <br><br>

            <label>Mật khẩu:</label>
            <input type="password" name="password" placeholder="******" required />
            <br>

            <p class="forgot">
                <a href="#">Quên mật khẩu?</a>
            </p>

            <button type="submit">ĐĂNG NHẬP</button>
        }


        <p class="register">
            Bạn chưa có tài khoản Admin?
            <!-- Trỏ sang trang Register của Admin -->
            <a href="@Url.Action("Register", "Account", new { area = "Admin" })">Tạo tài khoản</a>
        </p>

        <a href="@Url.Action("Index", "Home", new { area = "" })" class="thoat">←</a>
    </div>
</body>
</html>