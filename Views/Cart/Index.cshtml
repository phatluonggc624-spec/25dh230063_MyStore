@model List<_25dh230063_MyStore.Models.CartItem>
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h2 style="margin-top: 20px;">Giỏ hàng của bạn</h2>

@if (Model.Count == 0)
{
    <div style="background: white; padding: 30px; text-align: center; border: 1px solid #ddd; margin-top: 20px;">
        <p>Giỏ hàng đang trống.</p>
        <a href="@Url.Action("Index", "Home")" style="background: #1a73e8; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Tiếp tục mua hàng</a>
    </div>
}
else
{
    <table style="width: 100%; border-collapse: collapse; margin-top: 20px; background: white;">
        <thead>
            <tr style="background: #ffcf00; text-align: left;">
                <th style="padding: 10px; border: 1px solid #ddd;">Ảnh</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Tên sản phẩm</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Đơn giá</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Số lượng</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Thành tiền</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="padding: 10px; border: 1px solid #ddd;"><img src="@Url.Content("~/Content/images/" + item.ProductImage)" width="60" /></td>
                    <td style="padding: 10px; border: 1px solid #ddd;">@item.ProductName</td>
                    <td style="padding: 10px; border: 1px solid #ddd;">@item.UnitPrice.ToString("N0") đ</td>
                    <td style="padding: 10px; border: 1px solid #ddd;">
                        @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { style = "display:flex; gap:5px;" }))
                        {
                            <input type="hidden" name="productId" value="@item.ProductID" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" style="width: 50px;" />
                            <button type="submit" style="background: #ccc; border: none; cursor: pointer; padding: 5px;">Cập nhật</button>
                        }
                    </td>
                    <td style="padding: 10px; border: 1px solid #ddd; color: red; font-weight: bold;">@item.TotalPrice.ToString("N0") đ</td>
                    <td style="padding: 10px; border: 1px solid #ddd;">
                        @using (Html.BeginForm("RemoveItem", "Cart", FormMethod.Post))
                        {
                            <input type="hidden" name="productId" value="@item.ProductID" />
                            <button type="submit" style="background: red; color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer;">Xóa</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div style="text-align: right; margin-top: 20px; background: white; padding: 20px; border: 1px solid #ddd;">
        <h3>Tổng tiền: <span style="color:red;">@Model.Sum(x => x.TotalPrice).ToString("N0") đ</span></h3>
        <div style="margin-top: 15px;">
            <a href="@Url.Action("Index", "Home")" style="padding: 10px 20px; border: 1px solid #ccc; text-decoration: none; color: black; background: #eee;">Tiếp tục mua hàng</a>
            <!-- Nút Thanh toán sẽ trỏ sang OrderController mà tí nữa mình làm -->
            <a href="@Url.Action("Checkout", "Order")" style="background: green; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Tiến hành Thanh toán</a>
        </div>
    </div>
}
