@model _25dh230063_MyStore.Models.ViewModel.ProductDetailVM

@if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
{
    <div class="product-list">
        @foreach (var product in Model.RelatedProducts)
        {
            <div class="product-item">
                <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                    <img src="@Url.Content("~/Content/images/" + product.ProductImage)" alt="@product.ProductName" />
                    <h3>@product.ProductName</h3>
                </a>
                <p class="product-price">@product.ProductPrice.ToString("N0") đ</p>
            </div>
        }
    </div>
}
