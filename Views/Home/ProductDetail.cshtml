@model _25dh230063_MyStore.Models.ViewModel.ProductDetailVM
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div style="display: flex; gap: 30px; margin-top: 30px; background: white; padding: 20px; border: 1px solid #ddd; border-radius: 5px;">
    <!-- Ảnh sản phẩm -->
    <div style="flex: 1; text-align: center;">
      <img src="@(Model.product.ProductImage.StartsWith("http") ? Model.product.ProductImage : Url.Content("~/Content/images/" + Model.product.ProductImage))" alt="@Model.product.ProductName"  style="max-width: 100%; height: 300px; object-fit: contain; border: 1px solid #eee;" />
    </div>

    <!-- Thông tin sản phẩm -->
    <div style="flex: 1;">
        <h2>@Model.product.ProductName</h2>
        <p style="font-size: 24px; color: red; font-weight: bold; margin: 15px 0;">@Model.product.ProductPrice.ToString("N0") đ</p>

        <p><b>Mô tả:</b> @Model.product.ProductDescription</p>
        <hr />

        <!-- Form Thêm vào giỏ hàng -->
        <form action="/Cart/AddItem" method="post">
            <input type="hidden" name="productId" value="@Model.product.ProductID" />

            <div style="display: flex; align-items: center; gap: 15px; margin-top: 20px;">
                <label>Số lượng:</label>
                <input type="number" name="quantity" value="1" min="1" style="width: 60px; padding: 8px; border: 1px solid #ccc;" />

                <button type="submit" style="background: #ffcf00; color: black; border: none; padding: 10px 20px; border-radius: 5px; font-weight: bold; cursor: pointer;">
                    🛒 Thêm vào giỏ hàng
                </button>
            </div>
        </form>
    </div>
</div>

<hr />

<!-- SẢN PHẨM TƯƠNG TỰ (Gọi Partial View) -->
<h2 style="margin-top: 30px;">Sản phẩm tương tự</h2>
@Html.Partial("_PVRelatedProduct", Model)

<!-- TOP DEALS (Gọi Partial View) -->
<h2 style="margin-top: 30px;">Top Deals (Bán chạy cùng loại)</h2>
@Html.Partial("_PVTopProduct", Model)
