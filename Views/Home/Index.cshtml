@model _25dh230063_MyStore.Models.ViewModel.HomeProductVM
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<!-- BANNER CHÍNH -->
<div class="hero-banner">
    <h2>Chào mừng đến với E-commerce</h2>
    <p>Mua sắm trực tuyến vô cùng hấp dẫn và tiện lợi</p>
    <a href="#san-pham" class="btn-shop">Khám phá ngay</a>
</div>

<div class="container">
    <!-- TÌM KIẾM -->
    <div class="search-section">
        <h2>Tìm kiếm sản phẩm</h2>
        @using (Html.BeginForm("Index", "Home", FormMethod.Get))
        {
            @Html.TextBoxFor(m => m.SearchTerm, new { placeholder = "Nhập tên hoặc mô tả sản phẩm..." })
            <button type="submit">Tìm kiếm</button>
        }
    </div>

    <!-- SẢN PHẨM NỔI BẬT -->
    <h2 class="section-title">Sản phẩm nổi bật (Top 10)</h2>
    @Html.Partial("_PVFeatureProduct", Model)

    <!-- SẢN PHẨM MỚI -->
    <div id="san-pham">
        <h2 class="section-title">Sản phẩm mới</h2>
        @Html.Partial("_PVNewProduct", Model)
    </div>
</div>