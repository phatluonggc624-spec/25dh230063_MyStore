@model _25dh230063_MyStore.Models.ViewModel.HomeProductVM

@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <h2>Sản phẩm nổi bật (Top 10)</h2>
    <div class="product-list">
        @foreach (var product in Model.FeaturedProducts)
        {
            <div class="product-item">
                <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                    <img src="@(product.ProductImage.StartsWith("http") ? product.ProductImage : Url.Content("~/Content/images/" + product.ProductImage))" alt="@product.ProductName" />
                    <h3>@product.ProductName</h3>
                </a>
                <p class="product-price">@product.ProductPrice.ToString("N0") đ</p>
            </div>
        }
    </div>
}